# Copy this file to .env and fill in your values. Never commit .env.

# --- Required -------------------------------------------------------------
OPENAI_API_KEY=your-openai-api-key-here

# --- LLM (optional) -------------------------------------------------------
# Any OpenAI chat model with function calling, e.g. gpt-5.4-mini, gpt-5.4, gpt-4.1-mini
OPENAI_MODEL=gpt-5.4-mini
# Only for reasoning models (gpt-5.x, o-series): minimal | low | medium | high.
# Leave empty for non-reasoning models such as gpt-4.1 / gpt-4o.
OPENAI_REASONING_EFFORT=
# Optional: custom endpoint (e.g. a proxy). Leave unset for api.openai.com.
# OPENAI_BASE_URL=
LLM_MAX_TOKENS=8000
LLM_TIMEOUT_SECONDS=90
LLM_MAX_RETRIES=3

# --- Agent behaviour (optional) -------------------------------------------
MAX_AGENT_STEPS=6
MAX_USER_MESSAGE_CHARS=2000
KB_TOP_K=3
KB_MIN_SCORE=0.5
DUPLICATE_SIMILARITY_THRESHOLD=0.35

# --- Storage (optional, relative paths resolve from the project root) ------
DATABASE_PATH=var/it_support.db
CHECKPOINT_DB_PATH=var/checkpoints.db
SEED_DATA_DIR=data/seed

# --- Observability / UI (optional) -----------------------------------------
LOG_LEVEL=INFO
LOG_DIR=var/logs
APP_TITLE=AI IT Support Assistant
ORGANIZATION_NAME=Contoso Ltd.
